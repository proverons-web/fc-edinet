# FC EDINET v2.0.0

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Local development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel production:
# NEXT_PUBLIC_SITE_URL=https://YOUR-PROJECT.vercel.app
#
# After a custom domain is connected:
# NEXT_PUBLIC_SITE_URL=https://YOUR-DOMAIN.md

# Automatic RU -> RO translation (server only; never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY
# Optional. Defaults to gpt-5.6-luna
OPENAI_TRANSLATION_MODEL=gpt-5.6-luna
